{
    "family": "pia-python-task",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "2048",
    "executionRoleArn": "arn:aws:iam::406350346090:role/pia-ecs-execution-role",
    "taskRoleArn": "arn:aws:iam::406350346090:role/pia-ecs-execution-role",
    "containerDefinitions": [
        {
            "name": "pia-python",
            "image": "406350346090.dkr.ecr.us-east-1.amazonaws.com/pia-python:latest",
            "portMappings": [
                {
                    "containerPort": 8000,
                    "protocol": "tcp"
                }
            ],
            "secrets": [
                {
                    "name": "DATABASE_URL",
                    "valueFrom": "arn:aws:ssm:us-east-1:406350346090:parameter/pia/DATABASE_URL"
                },
                {
                    "name": "ANTHROPIC_API_KEY",
                    "valueFrom": "arn:aws:ssm:us-east-1:406350346090:parameter/pia/ANTHROPIC_API_KEY"
                },
                {
                    "name": "PAYLOAD_TOKEN",
                    "valueFrom": "arn:aws:ssm:us-east-1:406350346090:parameter/pia/PAYLOAD_TOKEN"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/pia-python",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs"
                }
            },
            "essential": true
        }
    ]
}